# Use este arquivo apenas para rodar a API direto no host, fora do Docker:
#   cp backend/.env.example backend/.env
# Dentro dos containers as variáveis vêm do docker compose e este arquivo nem existe.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# 'db' dentro do Docker; 'localhost' no host. A porta 5433 é a publicada pelo compose.
DB_HOST=localhost
DB_PORT=5433
DB_USER=wedding
DB_PASSWORD=troque-esta-senha
DB_NAME=wedding
DB_NAME_TEST=wedding_test

SESSION_COOKIE_NAME=rm_session
SESSION_TTL_DAYS=30

# Um cookie marcado Secure é descartado em silêncio sobre HTTP puro:
# ninguém consegue logar e não aparece erro em log nenhum. Só ligue com TLS na frente.
COOKIE_SECURE=false

# 10 em dev/test mantém seed e testes rápidos; 12 em produção.
BCRYPT_ROUNDS=10

CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
