# Copie para .env antes de subir o docker compose:  cp .env.example .env
# O docker compose lê este arquivo para interpolar ${...} nos serviços.

# --- Postgres ---
DB_USER=wedding
DB_PASSWORD=troque-esta-senha
DB_NAME=wedding
DB_NAME_TEST=wedding_test

# Porta publicada no host. 5433 e não 5432 para não colidir com um Postgres do sistema.
DB_PORT_HOST=5433

# --- Somente produção (docker-compose.prod.yml) ---
HTTP_PORT=8090

# Porta publicada da API no host (8080/8081 podem estar ocupadas por outros projetos)
API_PORT_HOST=3001
WEB_PORT_HOST=5173
PUBLIC_ORIGIN=http://localhost:8090

# --- Deploy público com TLS (docker-compose.tls.yml) ---
# Domínio que aponta para o IP público da VM. Sem domínio próprio, use o DNS
# que a Azure dá de graça à VM: <rotulo>.<regiao>.cloudapp.azure.com — o
# Let's Encrypt emite certificado para ele normalmente.
DOMAIN=casamento.exemplo.com
# E-mail para os avisos de expiração do Let's Encrypt.
TLS_EMAIL=voce@exemplo.com
# Com TLS na frente, PUBLIC_ORIGIN precisa ser https:// — ele alimenta o
# CORS_ORIGIN do backend.
# PUBLIC_ORIGIN=https://casamento.exemplo.com
